# Common config for all boards.
CONFIG_ESP_MAXIMUM_RETRY=20
CONFIG_ESP_UART_BRIDGE_1_ENABLED=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_DHCP6=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=12
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# mbedTLS tuning (only exercised once CONFIG_ESP_TLS_ENABLED=y). Buffer
# sized to the max TLS record (16384): a smaller one caused real
# mid-connection failures under bulk traffic. No cert bundle needed (this
# project never connects out to public HTTPS servers -- OTA is pushed in
# over our own private-CA mTLS, not fetched), saves flash.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=16384
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# OTA: custom two-slot partition table (see partitions_ota.csv) plus
# automatic rollback if a newly-booted image never confirms itself healthy
# (see main.c's esp_ota_mark_app_valid_cancel_rollback() call).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
